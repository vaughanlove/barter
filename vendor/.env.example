# Copy per vendor. All optional; defaults are demo values.
VENDOR_NAME=Barter Dummy Vendor
VENDOR_PRICE=76
VENDOR_FLOOR=60
VENDOR_UNDERCUT=3
# The vendor's own presentation verifier (sidecar /verify shape).
VERIFIER_URL=http://localhost:8080/verify
VERIFIER_TIMEOUT_MS=10000
# Muse Spark via TanStack AI (OpenAI-compatible adapter to the Meta API).
# Without MODEL_API_KEY the vendor runs on its deterministic fallback and
# the storefront chat (POST /api/chat) reports unavailable.
# MODEL_API_KEY=
# META_API_BASE_URL=https://api.meta.ai/v1
# VENDOR_MODEL=muse-spark-1.3
# VENDOR_AGENT_RUNTIME=TanStack AI
# Optional: also POST logs as OTLP/HTTP JSON to {endpoint}/v1/logs.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
